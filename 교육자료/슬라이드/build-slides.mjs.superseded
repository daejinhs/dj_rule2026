    ${['왜 맡기는지', '언제까지', '어디에 두는지', '어떻게 돌려받는지'].map(t =>
    `<div class="cell" style="border-top:2px solid var(--ink)">
      <div class="sv" style="font-size:31px;font-weight:700;letter-spacing:-.025em;line-height:1.35">${t}</div></div>`).join('')}
