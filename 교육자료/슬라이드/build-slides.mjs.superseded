/* ─────────────────────── 쓰기 ─────────────────────── */
const all = [...staff, ...student];
for (const [name, html] of all) writeFileSync(new URL(name, import.meta.url), html, 'utf8');

const GW = 1400, GH = 900, COLS = 4;
const place = (list, page) => list.map(([file], i) => ({
  file, page,
  x: (i % COLS) * GW, y: Math.floor(i / COLS) * GH,
  w: 1280, h: 720,
}));

const canvas = {
  pages: [
    { id: 'staff', name: '교직원 연수 (11장)' },
    { id: 'student', name: '학생 교육 (8장)' },
  ],
  artboards: [...place(staff, 'staff'), ...place(student, 'student')],
  launch: { view: 'canvas', page: 'staff' },
};
writeFileSync(new URL('canvas.json', import.meta.url), JSON.stringify(canvas, null, 2), 'utf8');
console.log(`wrote ${all.length} artboards + canvas.json`);
