  kicker: '마지막',
  h1: '여러분에게 보장되는 것들',
  body: `<div class="grid3" style="margin-top:8px;flex:1">
    <div class="a d4">
      <div class="lab red">선생님이 할 수 없는 것</div>
      <div style="margin-top:12px;display:flex;flex-direction:column;gap:9px">
        ${['체벌', '모욕 · 조롱', '공개적으로 망신 주기', '도구 · 신체로 고통 주기'].map(t =>
    `<div style="display:flex;gap:11px;align-items:flex-start">${X('var(--red)')}<span class="t20">${t}</span></div>`).join('')}
      </div>
      <div class="t16" style="margin-top:14px">다만 <b style="color:var(--ink2)">정당한 생활지도는 존중하고 따라야 합니다</b> (제76조①).</div>
