})]);

// 05 벌이 아닙니다
student.push(['StudentNotPunishment.dc.html', slide({
  n: 5, total: 8, deck: TD, accent: 'var(--blue)',
  kicker: '개별학생교육지원 &nbsp;·&nbsp; 전에는 \'분리지도\'라고 불렀습니다',
  h1: '이건 <b>벌이 아닙니다</b>',
  body: `<div style="flex:1;display:flex;flex-direction:column;justify-content:center">
    <div class="a d5" style="display:flex;gap:26px;align-items:flex-start;max-width:1000px">
      <span class="sv" style="font-size:80px;line-height:.8;color:var(--rule);font-weight:700">&ldquo;</span>
