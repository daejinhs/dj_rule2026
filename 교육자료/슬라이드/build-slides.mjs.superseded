// 대진고 학생생활규정 개정 교육 슬라이드 생성기
// 각 슬라이드를 .dc.html 아트보드로 써낸다. node build-slides.mjs
import { writeFileSync } from 'node:fs';

const FONTS = 'https://fonts.googleapis.com/css2?family=Hahmlet:wght@400;600;800&family=IBM+Plex+Sans+KR:wght@300;400;500;600;700&display=swap';

const CSS = `
:root{
  --paper:#FAF7F2; --paper2:#F1ECE2; --ink:#1C1A17; --ink2:#443E36;
  --muted:#7B7367; --rule:#DBD4C7; --hair:#E8E2D7;
  --red:#A0402C; --blue:#2C5183; --redwash:#F5E8E3; --bluewash:#E6EDF5;
}
*{box-sizing:border-box}
body{margin:0;background:var(--paper);color:var(--ink);
  font-family:'IBM Plex Sans KR','맑은 고딕','Malgun Gothic',sans-serif;
  font-weight:400;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
a{color:var(--red);text-decoration:none}
a:hover{color:#7E3120}
.slide{width:1280px;height:720px;background:var(--paper);position:relative;
  padding:66px 76px 64px;display:flex;flex-direction:column;overflow:hidden}
.sv{font-family:'Hahmlet','함초롬바탕','HCR Batang','Batang',serif;font-feature-settings:"palt" 1}

/* 상단 진행 괘선 */
.topbar{position:absolute;top:0;left:0;right:0;height:3px;background:var(--hair)}
.tick{position:absolute;left:0;top:0;height:3px;transform-origin:left center}

/* 머리 */
.kicker{font-size:16px;font-weight:600;letter-spacing:.15em;color:var(--muted);margin:0 0 14px}
.h1{font-family:'Hahmlet','함초롬바탕','HCR Batang','Batang',serif;
  font-size:54px;font-weight:800;line-height:1.16;letter-spacing:-.025em;margin:0}
.h1 em{font-style:normal;color:var(--red)}
.h1 b{font-weight:800;color:var(--blue)}
.rule{height:1px;background:var(--ink);opacity:.9;transform-origin:left center;margin:22px 0 0}
.rule.red{background:var(--red)}
.lead{font-size:20px;line-height:1.62;color:var(--ink2);margin:18px 0 0;max-width:900px}

/* 본문 */
.body{flex:1;display:flex;flex-direction:column;padding-top:26px;min-height:0}
.cols{display:flex;gap:44px;flex:1;min-height:0}
.col{flex:1;display:flex;flex-direction:column;gap:14px;min-width:0}
.vhair{width:1px;background:var(--hair);align-self:stretch}
.lab{font-size:14px;font-weight:600;letter-spacing:.13em;color:var(--muted)}
.lab.red{color:var(--red)}
.lab.blue{color:var(--blue)}
.t22{font-size:22px;font-weight:600;line-height:1.5}
.t20{font-size:20px;font-weight:500;line-height:1.55}
.t18{font-size:18px;line-height:1.62;color:var(--ink2)}
.t16{font-size:16px;line-height:1.62;color:var(--muted)}
.art{font-size:14px;font-weight:600;letter-spacing:.04em;color:var(--muted);
  font-variant-numeric:tabular-nums}

/* 목록 */
.rows{display:flex;flex-direction:column}
.row{display:flex;gap:24px;align-items:flex-start;padding:16px 0;border-top:1px solid var(--hair)}
.row:first-child{border-top:0}
.num{font-family:'Hahmlet','함초롬바탕','Batang',serif;font-size:30px;font-weight:600;
  color:var(--red);line-height:1;min-width:52px;font-variant-numeric:tabular-nums}
.bul{display:flex;gap:11px;align-items:flex-start}
.dot{width:5px;height:5px;border-radius:50%;background:var(--muted);margin-top:11px;flex:none}

/* 블록 */
.block{padding:18px 22px;background:var(--paper2)}
.block.blue{background:var(--blue);color:var(--paper)}
.block.blue .lab,.block.blue .t16{color:rgba(250,247,242,.72)}
.block.red{background:var(--redwash)}
.block.wash{background:var(--bluewash)}
.badge{display:inline-flex;align-items:center;gap:8px;padding:6px 13px;border:1px solid var(--red);
  color:var(--red);font-size:14px;font-weight:600;letter-spacing:.05em}
.tag{display:inline-block;padding:3px 9px;font-size:13px;font-weight:600;letter-spacing:.04em}
.tag.blue{background:var(--blue);color:var(--paper)}
.tag.ghost{border:1px solid var(--rule);color:var(--muted)}

/* 격자 */
.grid4{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:0}
.grid3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:34px}
.cell{padding:18px 20px 18px 0;border-top:1px solid var(--hair)}

/* 바닥 */
.foot{position:absolute;left:76px;right:76px;bottom:26px;display:flex;
  justify-content:space-between;align-items:baseline;font-size:13px;color:var(--muted);
  letter-spacing:.08em;font-variant-numeric:tabular-nums}
.note{font-size:15px;line-height:1.6;color:var(--muted);border-top:1px solid var(--hair);
  padding-top:13px;margin-top:auto}
.note b{color:var(--red);font-weight:600}
.band{margin-top:auto;padding:16px 22px;background:var(--red);color:var(--paper);
  font-size:19px;font-weight:500;letter-spacing:-.01em}

/* 표지 */
.cover{padding:0 76px;justify-content:center}
.cover .big{font-family:'Hahmlet','함초롬바탕','HCR Batang','Batang',serif;
  font-size:104px;font-weight:800;line-height:1.06;letter-spacing:-.035em;margin:0}
.cover .big em{font-style:normal;color:var(--red)}

/* 등장 */
@keyframes rise{from{opacity:0;transform:translateY(15px)}to{opacity:1;transform:none}}
@keyframes draw{from{transform:scaleX(0)}to{transform:scaleX(1)}}
@keyframes fade{from{opacity:0}to{opacity:1}}
.a{animation:rise .58s cubic-bezier(.2,.72,.25,1) both}
.f{animation:fade .7s ease both}
.aline{animation:draw .72s cubic-bezier(.2,.72,.25,1) both}
.d1{animation-delay:.06s}.d2{animation-delay:.16s}.d3{animation-delay:.26s}
.d4{animation-delay:.36s}.d5{animation-delay:.46s}.d6{animation-delay:.56s}
.d7{animation-delay:.66s}.d8{animation-delay:.76s}
@media (prefers-reduced-motion:reduce){.a,.f,.aline{animation:none!important}}
`;

const X = (c) => `<svg width="19" height="19" viewBox="0 0 20 20" fill="none" stroke="${c}" stroke-width="1.9" stroke-linecap="round" style="flex:none;margin-top:5px"><path d="M5.2 5.2l9.6 9.6M14.8 5.2l-9.6 9.6"/></svg>`;
const ARR = (c) => `<svg width="30" height="12" viewBox="0 0 30 12" fill="none" stroke="${c}" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" style="flex:none"><path d="M0 6h27M21.5 1.2L26.8 6l-5.3 4.8"/></svg>`;
const DN = (c) => `<svg width="12" height="26" viewBox="0 0 12 26" fill="none" stroke="${c}" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="flex:none"><path d="M6 0v23M1.4 18.4L6 23l4.6-4.6"/></svg>`;
const CK = (c) => `<svg width="19" height="19" viewBox="0 0 20 20" fill="none" stroke="${c}" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" style="flex:none;margin-top:5px"><path d="M3.6 10.6l4 4 8.8-9.2"/></svg>`;

function shell(inner) {
  return `<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <script src="./support.js"><\/script>
</head>
<body>
<x-dc>
<helmet>
  <link rel="stylesheet" href="${FONTS}">
  <style>${CSS}</style>
</helmet>
${inner}
</x-dc>
</body>
</html>
`;
}

// n: 순번, total: 총 장수, deck: 바닥 왼쪽 문구, accent: 상단 진행 괘선 색
function slide({ n, total, deck, accent = 'var(--ink)', kicker, h1, lead = '', body = '', cover = false }) {
  const pct = Math.round((n / total) * 100);
  const bar = `<div class="topbar"><span class="tick f" style="background:${accent};width:${pct}%"></span></div>`;
  const foot = `<div class="foot f d6"><span>${deck}</span><span>${String(n).padStart(2, '0')} / ${String(total).padStart(2, '0')}</span></div>`;
  if (cover) return shell(`<div class="slide cover">${bar}${body}${foot}</div>`);
  return shell(`<div class="slide">${bar}
  <p class="kicker a d1">${kicker}</p>
  <h1 class="h1 a d2">${h1}</h1>
  <div class="rule aline d3"></div>
  ${lead ? `<p class="lead a d4">${lead}</p>` : ''}
  <div class="body">${body}</div>
  ${foot}</div>`);
}

const SD = '교직원 연수 · 학생생활규정 전부개정';
const TD = '학생 교육 · 학생생활규정 개정';

/* ─────────────────────── 교직원 11장 ─────────────────────── */
const staff = [];

// 01 표지
staff.push(['Main.dc.html', slide({
  n: 1, total: 11, deck: SD, accent: 'var(--red)', cover: true,
  body: `
  <p class="kicker a d1" style="margin-bottom:26px">대진고등학교 &nbsp;·&nbsp; 교직원 연수</p>
  <h1 class="big a d2">학생생활규정<br><em>전부개정</em></h1>
  <div class="rule aline d4" style="margin:34px 0 0;width:560px"></div>
  <div class="a d5" style="display:flex;gap:56px;margin-top:26px">
    <div><div class="lab">시행</div><div class="t22" style="margin-top:6px">2026. 9. 1.</div></div>
    <div><div class="lab">구성</div><div class="t22" style="margin-top:6px">4편 9장 116조</div></div>
    <div><div class="lab">종전</div><div class="t22" style="margin-top:6px">11개 독립 규정</div></div>
  </div>
  <p class="t16 a d6" style="margin-top:40px">학생안전생활부 &nbsp;·&nbsp; 2026. 8. 31.<br>
  <span style="color:var(--rule)">PLUS(+) &amp; 4C 교육으로 모두가 행복한 학교</span></p>`,
})]);

// 02 오늘 가져갈 세 가지
staff.push(['Takeaways.dc.html', slide({
  n: 2, total: 11, deck: SD, kicker: '오늘 연수',
  h1: '조문은 외우지 않으셔도 됩니다',
  lead: '오늘 세 가지만 가져가시면 됩니다.',
  body: `<div class="rows" style="flex:1">
    <div class="row a d4"><div class="num">01</div><div>
      <div class="t22">생활지도 방법 8가지</div>
      <div class="t18" style="margin-top:5px">조언·상담·주의·훈육·훈계·보상·제지·물품 분리보관. 법령상 이름이 붙었습니다.</div></div></div>
    <div class="row a d5"><div class="num">02</div><div>
      <div class="t22">개별학생교육지원 절차</div>
      <div class="t18" style="margin-top:5px">요건 → 설명 → 실시 → 보고 → 복귀. 9월 1일부터 실제로 쓰는 절차입니다.</div></div></div>
    <div class="row a d6"><div class="num">03</div><div>
      <div class="t22">스마트기기 수거와 단계 지도</div>
      <div class="t18" style="margin-top:5px">우리 학교가 걷는 건 <b style="color:var(--red)">휴대폰만</b>입니다.</div></div></div>
  </div>
  <div class="note f d7">6월 교육공동체 의견수렴 &nbsp;응답 87명(학생 58 · 학부모 19 · 교직원 10) &nbsp;·&nbsp; <b>동의 100% · 반대 0명</b></div>`,
})]);

// 03 큰 틀 비교
const oldRules = [
  '학생생활규정 제정·개정 절차', '학생회 운영 규정', '학생 선도 규정', '교내·외 생활 규정',
  '복장 및 용의 규정', '학생 생활 평점제 규정', '생활지도위원회 규정',
];
staff.push(['Structure.dc.html', slide({
  n: 3, total: 11, deck: SD, kicker: '구조',
  h1: '규정 <em>11권</em>이 <b>1권</b>이 됐습니다',
  body: `<div class="cols" style="gap:30px;align-items:stretch">
    <div class="col" style="flex:0 0 400px">
      <div class="lab a d4">전 &nbsp;·&nbsp; 2022 &nbsp;—&nbsp; 11개 독립 규정</div>
      <div class="a d4" style="display:flex;flex-direction:column;gap:0;margin-top:2px">
        ${oldRules.map((r, i) => `<div style="display:flex;gap:12px;padding:7px 0;border-top:1px solid var(--hair);font-size:17px">
          <span class="art" style="min-width:16px">${i + 1}</span><span>${r}</span></div>`).join('')}
        <div style="display:flex;gap:12px;padding:7px 0;border-top:1px solid var(--hair);font-size:17px;color:var(--muted)">
          <span class="art" style="min-width:36px">8–11</span>
          <span>영상정보처리기기 · 현장체험학습 · 안전영향평가단 · 학교장추천전형</span></div>
      </div>
      <div class="t16 a d5" style="margin-top:4px">↳ 8–11번은 <b style="color:var(--ink2)">통합하지 않고 별도 규정으로 유지</b>합니다 (제6조②)</div>
    </div>
    <div class="a d5" style="align-self:center;padding:0 4px">${ARR('var(--red)')}</div>
    <div class="col" style="flex:1">
      <div class="lab a d5">후 &nbsp;·&nbsp; 2026 &nbsp;—&nbsp; 학생생활규정 한 권 &nbsp;·&nbsp; 4편 9장 116조</div>
      <div class="a d6" style="display:flex;flex-direction:column;gap:8px">
        <div class="block" style="display:flex;justify-content:space-between;align-items:baseline;gap:16px">
          <span class="t20">제1편 &nbsp;총칙</span>
          <span class="t16">제1~15조 &nbsp;·&nbsp; 옮겨 담음 + 제1~5조 신설</span></div>
        <div class="block" style="display:flex;justify-content:space-between;align-items:baseline;gap:16px">
          <span class="t20">제2편 &nbsp;학생의 학교생활</span>
          <span class="t16">제16~73조 &nbsp;·&nbsp; 그대로 + 제31조 신설</span></div>
        <div class="block blue" style="display:flex;justify-content:space-between;align-items:baseline;gap:16px;padding:22px">
          <span class="t20" style="font-weight:600">제3편 &nbsp;생활지도와 교육지원</span>
          <span class="t16" style="color:rgba(250,247,242,.85)">제74~100조 &nbsp;·&nbsp; <b>제74~95조 전부 신설</b></span></div>
        <div class="block" style="display:flex;justify-content:space-between;align-items:baseline;gap:16px">
          <span class="t20">제4편 &nbsp;징계</span>
          <span class="t16">제101~116조 &nbsp;·&nbsp; 그대로</span></div>
      </div>
      <div class="t18 a d7" style="margin-top:4px">복장·용의, 상벌점, 징계 기준은 <b style="color:var(--ink)">내용이 그대로</b>입니다.
        새로 생긴 건 <b style="color:var(--blue)">제3편 제6·7장</b> 하나뿐입니다.</div>
    </div>
  </div>
  <div class="note f d8">개정 사유 &nbsp; ① 법령 개정 반영 — 초·중등교육법 제18조의5 · 제20조의2 · 제20조의4 · 제20조의5 신설 &nbsp;
    ② 11개 규정 통합 &nbsp; ③ 스마트기기 환경 반영</div>`,
})]);

// 04 말이 바뀐 것들
const bigTerms = [
  ['학생선도위원회', '학생생활교육위원회', '제103조'],
  ['분리지도', '개별학생교육지원', '제89조'],
  ['통신기기', '스마트기기', '제30·31조'],
];
const smallTerms = [
  ['소지품 검사', '물품의 조사 및 분리보관', '제86조'],
  ['학부모', '보호자', '제4조2호'],
  ['학생부', '학생안전생활부', '—'],
  ['생활지도위원회 규정', '폐지 · 별도 규정으로', '제6조②'],
];
staff.push(['Terms.dc.html', slide({
  n: 4, total: 11, deck: SD, kicker: '용어',
  h1: '이름만 바뀐 게 아닙니다',
  lead: "'선도'는 벌 주는 말이고 '생활교육'은 가르치는 말입니다. '분리'는 빼는 말이고 '교육지원'은 돕는 말입니다.",
  body: `<div class="rows">
    ${bigTerms.map(([a, b, c], i) => `<div class="row a d${i + 4}" style="align-items:center;padding:15px 0">
      <span class="t22" style="color:var(--muted);min-width:260px;font-weight:400">${a}</span>
      ${ARR('var(--red)')}
      <span class="sv" style="font-size:33px;font-weight:700;letter-spacing:-.02em;flex:1">${b}</span>
      <span class="art">${c}</span></div>`).join('')}
  </div>
  <div class="grid4 a d7" style="margin-top:16px">
    ${smallTerms.map(([a, b, c]) => `<div class="cell" style="padding-right:22px">
      <div class="t16" style="text-decoration:line-through;text-decoration-color:var(--rule)">${a}</div>
      <div class="t18" style="color:var(--ink);font-weight:500;margin-top:3px">${b}</div>
      <div class="art" style="margin-top:5px">${c}</div></div>`).join('')}
  </div>
  <div class="note f d8"><b>'선도'라는 말 자체는 제4편에 그대로 남아 있습니다</b> — 선도 기간(제110조) · 통보(제113조) · 경감(제115조) · 해제(제116조).
    바뀐 것은 위원회 이름입니다. &nbsp;/&nbsp; 기안문·가정통신문·기록지 용어를 바꿔 주십시오.</div>`,
})]);

// 05 생활지도 8가지
const methods = [
  ['제79조', '조언', '문제를 인식했거나 도움을 요청할 때. 사생활 조언은 비공개 원칙'],
  ['제80조', '상담', '수업시간 외 원칙. 폭언·협박·폭행 시 중단할 수 있습니다'],
  ['제81조', '주의', '사유와 개선 방향을 함께 제시하는 방식으로'],
  ['제82조', '훈육', '과업 부여 · 지시 · 말로 제지. 공개 망신 금지'],
  ['제83조', '훈계', '대안행동 · 성찰 글쓰기 · 원상회복 부여 가능'],
  ['제84조', '보상', '칭찬 · 상 · 격려 · 역할 부여 · 회복적 참여 기회'],
  ['제85조', '제지', '긴급한 경우에 한하여. 실시하면 학교장 보고'],
  ['제86조', '물품 조사·분리보관', '사유·기간·장소·반환 방법을 알리고 실시'],
];
staff.push(['Methods.dc.html', slide({
  n: 5, total: 11, deck: SD, accent: 'var(--blue)',
  kicker: '제3편 제6장 &nbsp;·&nbsp; 제74~88조 신설',
  h1: '선생님이 할 수 있는 지도, <b>여덟 가지</b>',
  lead: '종전에는 이름이 없었습니다. 이제 법령상 여덟 가지로 정의되었습니다.',
  body: `<div class="grid4" style="gap:0 34px;margin-top:6px">
    ${methods.map(([art, name, desc], i) => `<div class="cell a d${Math.min(8, 4 + Math.floor(i / 4))}">
